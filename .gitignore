__pycache__/
*.pyc
.tmp/
log/*.log
.caddy/
# LaTeX build byproducts. The report itself only ever builds inside report/
# (see report/Makefile) — these patterns exist for the root so a `pdflatex`
# run from the wrong directory can't accidentally get committed again.
/*.aux
/*.log
/*.out
/*.toc
vendor/easy_ViTPose/easy_ViTPose.egg-info/
.venv
**/.venv/
private/
.claude/worktrees/

# Scratch landing spot for raw clips waiting to be batch-extracted into
# tests/fixtures/ (see tests/README.md) — only the curated, trimmed output
# of that process gets committed, not whatever gets dropped in here.
clips_inbox/*
!clips_inbox/.gitkeep
.DS_Store
# Private fixtures/examples: clips you don't want in the repo. Same layout as
# tests/fixtures/global/ (own manifest.json, <stance>/ subfolders); the app
# merges both into one example gallery and the tests score both. Their golden
# snapshots are private too.
tests/fixtures/local/*
!tests/fixtures/local/.gitkeep
tests/golden/local/*
!tests/golden/local/.gitkeep

# Spike results: tracks of third-party videos and device probes stay local.
spike/**/results/
