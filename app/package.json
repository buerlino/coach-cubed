{
  "name": "coach-app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"../tests/app/*.test.js\"",
    "assemble": "node tools/assemble.mjs",
    "serve": "node tools/serve.mjs",
    "test:page": "node tools/page-test.mjs",
    "check:layout": "node tools/layout-check.mjs",
    "check:capture": "node tools/check-capture.mjs",
    "test:layout-breaks": "env COACH_LAYOUT_BREAKS=1 node --test ../tests/app/wide.test.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@tensorflow-models/pose-detection": "2.1.3",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "esbuild": "0.28.2",
    "long": "4.0.0",
    "seedrandom": "3.0.5"
  }
}
