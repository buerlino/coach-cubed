<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (the app targets SDK 36): allowBackup="false" stops the cloud
     backup but not the device-to-device transfer, so both are excluded here, every
     domain whole. S1's privacy text says the lifts stay on this phone (c43). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
