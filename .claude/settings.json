{
  "permissions": {
    "deny": [
      "Read(/src/vendor/**)",
      "Read(/src/squat/vendor/**)",
      "Read(/src/pose/vendor/**)",
      "Read(/src/anatomy/models/body.*)",
      "Read(/scripts/anatomy-selection.json)",
      "Read(/parked/report/analysis.ipynb)",
      "Read(**/*.track.json)",
      "Read(/tests/golden/**)",
      "Read(**/*.mp4)",
      "Read(/log/**)",
      "Read(**/__pycache__/**)",
      "Read(/.venv/**)",
      "Read(/.auth_password)",
      "Read(/.caddy/**)",
      "Edit(/.caddy/**)",
      "Read(/spike/**/results/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/adb_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
